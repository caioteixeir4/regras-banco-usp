# Bloco que infra/scripts/apply-network-hardening.ps1 acrescenta ao listener.ora do container, entre
# os marcadores "# >>> KAWASHI" e "# <<< KAWASHI". Este arquivo e a fonte: mude aqui e rode o script.
# Ninguem reconfigura o listener pela rede (SET, STOP...); so de dentro do container.
ADMIN_RESTRICTIONS_LISTENER = ON
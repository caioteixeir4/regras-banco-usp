# Bloco que infra/scripts/apply-network-hardening.ps1 acrescenta ao sqlnet.ora do container, entre
# os marcadores "# >>> KAWASHI" e "# <<< KAWASHI". Este arquivo e a fonte: mude aqui e rode o script.
# Toda conexao pela rede e cifrada (REQUIRED recusa quem nao cifra) e conferida contra adulteracao.
SQLNET.ENCRYPTION_SERVER = REQUIRED
SQLNET.ENCRYPTION_TYPES_SERVER = (AES256)
SQLNET.CRYPTO_CHECKSUM_SERVER = REQUIRED
SQLNET.CRYPTO_CHECKSUM_TYPES_SERVER = (SHA256)
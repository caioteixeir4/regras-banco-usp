# Copie este arquivo para ".env" (mesma pasta) e preencha com valores reais.
# O ".env" nunca deve ser commitado — está no .gitignore.

# Senha do usuário SYS/SYSTEM (admin root do Oracle)
ORACLE_PASSWORD=

# Usuário e senha da aplicação (Spring Boot), criados automaticamente pela imagem
# gvenzl/oracle-free a partir destas variáveis. Os scripts em oracle-init/06_access_management.sql
# aplicam profile/roles/quota em cima deste mesmo usuário — não altere o nome sem atualizar o script.
APP_USER=KAWASHI_USER
APP_USER_PASSWORD=

# Token root do Vault em modo dev (apenas para desenvolvimento local)
VAULT_DEV_ROOT_TOKEN_ID=

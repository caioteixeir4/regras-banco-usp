# Copie este arquivo para ".env" (mesma pasta) e preencha com valores reais.
# O ".env" nunca deve ser commitado — está no .gitignore.

# Senha do usuário SYS/SYSTEM (admin root do Oracle)
ORACLE_PASSWORD=

# Usuário e senha da aplicação Spring Boot. O nome da variável aqui é só pra clareza -
# dentro do container ele continua se chamando APP_USER (é o que a imagem gvenzl/oracle-free
# exige pra criar o usuário sozinha). Ver docker-compose.yml, que faz essa ponte.
SPRING_APP_USER=KAWASHI_SPRING_USER
SPRING_APP_USER_PASSWORD=

# Usuário e senha pessoal do engenheiro do projeto (uso humano, nao de aplicacao).
# Criado com privilegio DBA pelo oracle-init/08_engineer_account.sql. ESTE VALOR E
# PESSOAL - troque SEU_NOME_SOBRENOME pelo seu proprio nome antes de preencher a senha,
# nunca deixe o placeholder abaixo nem reaproveite o nome de outra pessoa. Cada
# engenheiro tem sua propria conta - nunca compartilhe a mesma entre pessoas.
ENGINEER_USER=SEU_NOME_SOBRENOME
ENGINEER_USER_PASSWORD=

# Token root do Vault em modo dev (apenas para desenvolvimento local)
VAULT_DEV_ROOT_TOKEN_ID=
